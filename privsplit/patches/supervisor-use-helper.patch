+# Root actions go through the privsplit helper when GB_ROOT_HELPER=1. With the
+# flag on and the helper down, nothing falls back to running rmmod/modprobe here.
+_USE_HELPER = os.environ.get("GB_ROOT_HELPER", "0") == "1"
+_helper = None
+def _helper_client():
+    global _helper
+    if _helper is None:
+        sys.path.insert(0, "/usr/local/lib/greenboost/privsplit")
+        from gb_helper_client import HelperClient
+        _helper = HelperClient()
+    return _helper
+
