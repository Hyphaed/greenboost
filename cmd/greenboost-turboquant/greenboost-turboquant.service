[Unit]
Description=GreenBoost TurboQuant — KV cache compression auto-selector
Documentation=https://github.com/ferranduarri/greenboost
After=network.target ollama.service greenboost.service
Wants=ollama.service

[Service]
Type=notify
ExecStart=/usr/local/bin/greenboost-turboquant
Restart=on-failure
RestartSec=5s

# Run as root so it can open /dev/greenboost and write /run/greenboost/
User=root

# Runtime directory for turboquant.conf
RuntimeDirectory=greenboost
RuntimeDirectoryMode=0755

Environment=PYTHONUNBUFFERED=1

# Harden the service — only needs device access + network (Ollama API)
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/greenboost
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
