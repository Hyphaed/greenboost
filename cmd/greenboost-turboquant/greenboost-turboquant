#!/usr/bin/env bash
# GreenBoost TurboQuant daemon launcher
# Installed to /usr/local/bin/greenboost-turboquant by full-install.
# Runs the Python daemon package from its installed location.

set -euo pipefail

PACKAGE_DIR="/usr/local/lib/greenboost"

if [[ -d "$PACKAGE_DIR/cmd/greenboost-turboquant" ]]; then
    cd "$PACKAGE_DIR"
    exec python3 -m cmd.greenboost-turboquant "$@"
else
    # Development fallback: run from source tree
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    cd "$(dirname "$(dirname "$SCRIPT_DIR")")"
    exec python3 -c "
import sys, runpy
sys.path.insert(0, '.')
# Normalize package name (dashes not valid in Python module names)
import importlib.util, pathlib
spec = importlib.util.spec_from_file_location(
    'greenboost_turboquant.__main__',
    pathlib.Path('cmd/greenboost-turboquant/main.py'),
    submodule_search_locations=['cmd/greenboost-turboquant']
)
mod = importlib.util.module_from_spec(spec)
sys.modules['greenboost_turboquant'] = mod
spec.loader.exec_module(mod)
" "$@"
fi
